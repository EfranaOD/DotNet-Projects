<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="150"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Label Content="User Management System"
               Grid.Row="0"
               Grid.Column="0"
               Grid.ColumnSpan="2"
               HorizontalAlignment="Center" />
        <Label Content="Name"
               Grid.Row="1"
               Grid.Column="0"
               Margin="3"
               HorizontalAlignment="Left" />
        <Label Content="Email"
               Grid.Row="2"
               Grid.Column="0"
               Margin="3"
               HorizontalAlignment="Left" />
        <Label Content="Age"
               Grid.Row="3"
               Grid.Column="0"
               Margin="3"
               HorizontalAlignment="Left" />
        <Label Content="Password"
               Grid.Row="4"
               Grid.Column="0"
               Margin="3"
               HorizontalAlignment="Left" />
        <TextBox Name="txtName"
                 Grid.Row="1"
                 Grid.Column="1"
                 Margin="3" />
        <TextBox Name="txtEmail"
                 Grid.Row="2"
                 Grid.Column="1"
                 Margin="3" />
        <TextBox Name="txtAge"
                 Grid.Row="3"
                 Grid.Column="1"
                 Margin="3" />
        <PasswordBox Name="txtPassword"
                 Grid.Row="4"
                 Grid.Column="1" 
                 Margin="3" />
        <StackPanel Grid.Row="5"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center">
            <Button Content="Create" Name="btnCreate" Margin="2" Padding="2" Click="btnCreate_Click" />
            <Button Content="Read" Name="btnRead" Margin="2" Padding="2" Click="btnRead_Click" />
            <Button Content="Update" Name="btnUpdate" Margin="2" Padding="2" Click="btnUpdate_Click" />
            <Button Content="Delete" Name="btnDelete" Margin="2" Padding="2" Click="btnDelete_Click" />
        </StackPanel>
        <DataGrid Name="dgUsers"
                  Grid.Row="6"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  Margin="3" SelectionChanged="dgUsers_SelectionChanged" />
    </Grid>
</Window>
